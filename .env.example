# Variables Docker Compose — copier ce fichier en `.env` pour les surcharger.
# Toutes les valeurs ont un défaut : le projet démarre sans fichier .env.

# --- PostgreSQL ---
POSTGRES_DB=kos
POSTGRES_USER=kos
POSTGRES_PASSWORD=kos
# Port hôte exposé pour la base (5432/5433/5434/5436 déjà pris en local)
POSTGRES_HOST_PORT=5437

# --- Ports exposés (vérifiés libres) ---
BACKEND_HOST_PORT=8090
FRONTEND_HOST_PORT=3010
ADMINER_HOST_PORT=8083

# --- Frontend : URL de l'API vue par le navigateur (injectée au build) ---
NEXT_PUBLIC_API_URL=http://localhost:8090
